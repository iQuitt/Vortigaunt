// Windows Resource file for application icon and version metadata

#include "../core/VortigauntVersion.h"

// IDI_ICON1 is the main application icon
// The first icon in the file is used by Windows Explorer
IDI_ICON1 ICON "app2.ico"

// For stupid Smartscreen.
1 VERSIONINFO
FILEVERSION     VORTIGAUNT_VERSION_MAJOR,VORTIGAUNT_VERSION_MINOR,VORTIGAUNT_VERSION_PATCH,0
PRODUCTVERSION  VORTIGAUNT_VERSION_MAJOR,VORTIGAUNT_VERSION_MINOR,VORTIGAUNT_VERSION_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L  // VOS_NT_WINDOWS32
FILETYPE        0x1L      // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // en-US, Unicode
        BEGIN
            VALUE "CompanyName",      "XecT"
            VALUE "FileDescription",  "Vortigaunt - A Porting Tool for Goldsrc Engine"
            VALUE "FileVersion",      VORTIGAUNT_VERSION_STRING
            VALUE "InternalName",     "VortigauntTool_gui"
            VALUE "LegalCopyright",   "Copyright (C) iQuitt - https://github.com/iQuitt/Vortigaunt"
            VALUE "OriginalFilename", "VortigauntTool_gui.exe"
            VALUE "ProductName",      "Vortigaunt Tool"
            VALUE "ProductVersion",   VORTIGAUNT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
